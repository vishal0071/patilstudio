# ──────────────────────────────────────────────────────────────
#  Patil Studio — environment variables
#  Copy to `.env` and fill in: `cp .env.example .env`
#  `.env` is gitignored. Never commit a real password.
# ──────────────────────────────────────────────────────────────

# The public hostname. Drives the Traefik router rule and the site's own
# metadataBase; `www.` is added automatically alongside it.
SITE_DOMAIN=patilstudio.in

# Absolute base URL used in canonical tags, Open Graph, sitemap.xml and the JSON-LD
# @id values. Compose derives it from SITE_DOMAIN; set it directly for local work.
# SITE_BASE_URL=http://localhost:3002

# ── Database ────────────────────────────────────────────────────
# A SEPARATE database and role inside GalleryFlow's existing Postgres 17
# container. Host is `postgres` (the compose service name on the shared network),
# port 5432 (the container's internal port — NOT the 5433 published to the host).
#
# Generate the password with `openssl rand -base64 24`, put the SAME value in
# infrastructure/postgres/001-create-database.sql before running it, and keep it
# out of git. It must be URL-encoded here if it contains @ : / ? # or %.
DATABASE_URL=postgresql://patilstudio:REPLACE_ME@postgres:5432/patilstudio?schema=public

# Apply pending Prisma migrations on container boot. Leave true.
RUN_MIGRATIONS=true

# ── Admin panel ─────────────────────────────────────────────────
# The studio owner signs in at /admin with this password. There is no user table
# and no reset flow — one password, one editor. Minimum 8 characters.
#
# LEAVE IT UNSET AND THE PANEL IS CLOSED: every sign-in is refused rather than the
# panel falling open. Generate one with `openssl rand -base64 24`.
ADMIN_PASSWORD=

# Signs the admin session cookie. Optional — without it the password doubles as the
# signing key, which works but means the two cannot be rotated independently.
# `openssl rand -base64 32`
ADMIN_SESSION_SECRET=

# Where uploaded photographs are written. In production this is the `patil_uploads`
# volume mounted at /app/uploads (see docker-compose.yml); locally it defaults to
# ./uploads. NOT under public/ — see uploads/README.md for why.
UPLOAD_DIR=

# ── Proxy chain ─────────────────────────────────────────────────
# How many proxies sit in front of this container, each appending one entry to
# X-Forwarded-For. Both rate limiters (enquiry form, admin login) count back this
# many entries to find the real client, so the value has to match reality:
#
#   1  Traefik only — the current deployment. Correct default.
#   2  Cloudflare (or any CDN) in front of Traefik.
#
# Too LOW with a CDN in front is the dangerous direction and it fails silently: every
# visitor resolves to the CDN's edge address, so they all share one rate-limit bucket
# and five enquiries throttle the entire site. Too high collapses to a single shared
# bucket instead, which is safe but equally throttled. See lib/client-ip.ts.
TRUSTED_PROXY_HOPS=1

# ── Images ──────────────────────────────────────────────────────
# Comma-separated hostnames next/image may optimise from, if photographs are served
# from a CDN rather than the container's own volume. Empty is correct for the
# default setup.
#
# Read at BUILD time (next.config.ts) — compose passes it through as a build arg, so
# changing it requires `docker compose up -d --build`, not just a restart.
IMAGE_CDN_HOSTS=

# ── Enquiry notifications ───────────────────────────────────────
# Optional. Every enquiry is written to Postgres and readable at /admin/inquiries
# regardless; these only add an email on top. Unset, each enquiry is logged as a
# single greppable line instead.
#
# Sent over Resend's HTTP API (no SMTP library). INQUIRY_NOTIFY_FROM must be an
# address on a domain verified in Resend; INQUIRY_NOTIFY_TO may be comma-separated.
RESEND_API_KEY=
INQUIRY_NOTIFY_TO=
INQUIRY_NOTIFY_FROM=
